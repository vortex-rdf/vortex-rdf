{
    "name": "@vortex-rdf/vortex-rdf-store",
    "version": "0.10.0",
    "description": "High-performance, zero-copy columnar RDF serialization format",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vortex-rdf/vortex-rdf.git",
        "directory": "js"
    },
    "publishConfig": {
        "access": "public"
    },
    "main": "./entry/browser.js",
    "types": "./entry/types.d.ts",
    "exports": {
        ".": {
            "node": {
                "types": "./entry/types.d.ts",
                "default": "./entry/node.js"
            },
            "browser": {
                "types": "./entry/types.d.ts",
                "default": "./entry/browser.js"
            },
            "default": {
                "types": "./entry/types.d.ts",
                "default": "./entry/browser.js"
            }
        }
    },
    "files": [
        "entry/node.js",
        "entry/browser.js",
        "entry/types.d.ts",
        "pkg/web/vortex_rdf.js",
        "pkg/web/vortex_rdf.d.ts",
        "pkg/web/vortex_rdf_bg.wasm",
        "pkg/web/vortex_rdf_bg.wasm.d.ts",
        "pkg/web/snippets/**"
    ],
    "scripts": {
        "build:wasm": "wasm-pack build --target web --out-dir pkg/web --no-pack",
        "build:wasm:fast": "wasm-pack build --target web --out-dir pkg/web --no-pack --no-opt",
        "build:hdt-wasm": "RUSTFLAGS='-C target-feature=+simd128' wasm-pack build bench/hdt-wasm --target web --out-dir ../hdt-pkg --no-pack && npm run build:hdt-clean-generated",
        "build:hdt-clean-generated": "node -e \"require('fs').rmSync('bench/hdt-pkg/.gitignore',{force:true})\"",
        "build:reset": "node -e \"require('fs').rmSync('pkg/web',{recursive:true,force:true})\"",
        "build:clean-generated": "node -e \"const fs=require('fs');for (const f of ['pkg/web/package.json','pkg/web/.gitignore']) fs.rmSync(f,{force:true})\"",
        "build": "npm run build:reset && npm run build:wasm && npm run build:clean-generated",
        "build:fast": "npm run build:reset && npm run build:wasm:fast && npm run build:clean-generated",
        "prepublishOnly": "npm run build",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.json && tsc -p bench/tsconfig.json",
        "bench": "tsx --expose-gc --max-old-space-size=8192 bench/compare.bench.ts",
        "bench:build": "npm run build && npm run bench",
        "bench:codspeed": "node --import tsx --expose-gc --no-liftoff bench/codspeed.bench.ts",
        "bench:dict-memory": "tsx --expose-gc bench/dict-memory.bench.ts"
    },
    "keywords": [
        "rdf",
        "vortex",
        "columnar",
        "semantic-web",
        "wasm",
        "zero-copy"
    ],
    "author": "Julián Rojas",
    "license": "MIT",
    "devDependencies": {
        "@codspeed/tinybench-plugin": "^5.7.1",
        "@types/node": "^26.1.2",
        "oxigraph": "^0.5.9",
        "rdf-data-factory": "^2.0.2",
        "rdf-stores": "^2.2.0",
        "tinybench": "^6.1.2",
        "tsx": "^4.23.4",
        "typescript": "^7.0.2",
        "vitest": "^5.0.0",
        "wasm-pack": "^0.15.0"
    },
    "dependencies": {
        "@rdfjs/types": "^2.0.1"
    }
}
