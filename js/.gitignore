/pkg/
/node_modules/
# Written by `npm run bench:dict-memory` and read back by hand for the memory
# sweep. Not committed.
/bench/dict-memory.json
# Built by `npm run build:hdt-wasm` (see bench/hdt-wasm). Only the type
# declaration is committed, so `npm run typecheck` resolves the module on a
# checkout that never runs that build — CI among them.
/bench/hdt-pkg/*
!/bench/hdt-pkg/hdt_wasm_bench.d.ts
# Built by `npm run build:oxigraph-wasm` (see bench/oxigraph-wasm). Only the
# type declaration is committed, for the same reason as hdt-pkg's.
/bench/oxigraph-pkg/*
!/bench/oxigraph-pkg/web.d.ts
