#!/usr/bin/env bash
# Installed as the repo's commit-msg hook (see scripts/install-git-hooks.sh).
# Enforces Conventional Commits (https://www.conventionalcommits.org) so that
# scripts/update-changelog.sh can generate CHANGELOG.md from history.
# Skip once with `git commit --no-verify`.
set -euo pipefail

msg_file="$1"
# First non-comment, non-empty line = the commit subject.
subject="$(grep -vE '^\s*#' "$msg_file" | grep -vE '^\s*$' | head -n1 || true)"

# Let git's own housekeeping commits through untouched.
case "$subject" in
  Merge\ *|Revert\ *|"fixup! "*|"squash! "*|Reapply\ *) exit 0 ;;
esac

# type(optional scope)(optional !): description
# Keep this type list in sync with cliff.toml's commit_parsers: every accepted
# type must have a parser prefix there, or it lands in the catch-all group.
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert|deprecate|remove|security)(\([a-z0-9,._/-]+\))?!?: .+'

if [[ ! "$subject" =~ $pattern ]]; then
  cat >&2 <<EOF
✖ Commit message is not a Conventional Commit.

  Got:      $subject

  Expected: <type>[optional scope][!]: <description>
  Types:    feat fix docs style refactor perf test build ci chore revert
            deprecate remove security
  Examples: feat(core): add out-of-core sorted stream builder
            fix(js): guard against empty dataset
            perf!: change default column layout (breaking)

Skip this check once with: git commit --no-verify
EOF
  exit 1
fi
