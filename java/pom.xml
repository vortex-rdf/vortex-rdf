<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.vortexrdf</groupId>
  <artifactId>vortex-rdf</artifactId>
  <!-- The workspace version (Cargo.toml): the jar and the native library it loads are released together. -->
  <version>0.13.1</version>
  <packaging>jar</packaging>

  <name>Vortex-RDF</name>
  <description>Java bindings for Vortex-RDF, a columnar RDF store format built on Vortex</description>
  <url>https://github.com/vortex-rdf/vortex-rdf</url>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <properties>
    <maven.compiler.release>11</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.3</junit.version>
    <!-- The tests' inputs: the native library, and the stores and oracle that the `fixtures` example of the
         vortex-rdf-java crate writes (scripts/ci-check.sh java-tests builds both). -->
    <vortexrdf.library>${project.basedir}/../target/debug/libvortex_rdf_jni.so</vortexrdf.library>
    <vortexrdf.fixtures>${project.basedir}/target/fixtures</vortexrdf.fixtures>
    <!-- True makes BundledLibraryTest fail, not skip, when no library is staged under target/natives
         (scripts/ci-check.sh java-tests stages this machine's). -->
    <vortexrdf.bundled.required>false</vortexrdf.bundled.required>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <compilerArgs>
            <arg>-Xlint:all</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <executions>
          <!-- Every test but BundledLibraryTest, with the library vortexrdf.library names. -->
          <execution>
            <id>default-test</id>
            <configuration>
              <excludes>
                <exclude>**/BundledLibraryTest.java</exclude>
              </excludes>
              <systemPropertyVariables>
                <vortexrdf.library>${vortexrdf.library}</vortexrdf.library>
                <vortexrdf.fixtures>${vortexrdf.fixtures}</vortexrdf.fixtures>
              </systemPropertyVariables>
            </configuration>
          </execution>
          <!-- BundledLibraryTest alone, in a JVM of its own: target/natives is on the class path, as the jar's
               libraries would be, and nothing names a library (no -D property reaches it, VORTEX_RDF_JNI_LIB is
               removed). Set in the POM, <test> keeps a command-line -Dtest from redirecting it. -->
          <execution>
            <id>bundled-library</id>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <test>BundledLibraryTest</test>
              <additionalClasspathElements>
                <additionalClasspathElement>${project.build.directory}/natives</additionalClasspathElement>
              </additionalClasspathElements>
              <promoteUserPropertiesToSystemProperties>false</promoteUserPropertiesToSystemProperties>
              <systemPropertyVariables>
                <vortexrdf.fixtures>${vortexrdf.fixtures}</vortexrdf.fixtures>
                <vortexrdf.bundled.required>${vortexrdf.bundled.required}</vortexrdf.bundled.required>
              </systemPropertyVariables>
              <excludedEnvironmentVariables>
                <excludedEnvironmentVariable>VORTEX_RDF_JNI_LIB</excludedEnvironmentVariable>
              </excludedEnvironmentVariables>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- The native library's file name where it is not Linux's. -->
    <profile>
      <id>macos</id>
      <activation>
        <os>
          <family>mac</family>
        </os>
      </activation>
      <properties>
        <vortexrdf.library>${project.basedir}/../target/debug/libvortex_rdf_jni.dylib</vortexrdf.library>
      </properties>
    </profile>
    <profile>
      <id>windows</id>
      <activation>
        <os>
          <family>windows</family>
        </os>
      </activation>
      <properties>
        <vortexrdf.library>${project.basedir}/../target/debug/vortex_rdf_jni.dll</vortexrdf.library>
      </properties>
    </profile>
    <!-- Java 24 and later warn when a native library loads unless native access is enabled. -->
    <profile>
      <id>native-access</id>
      <activation>
        <jdk>[24,)</jdk>
      </activation>
      <properties>
        <argLine>--enable-native-access=ALL-UNNAMED</argLine>
      </properties>
    </profile>
  </profiles>
</project>
