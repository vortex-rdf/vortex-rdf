# The stamp scripts/refresh.sh writes beside the extension it builds. maturin
# honours this file, so the rule also keeps the stamp out of wheels and sdists.
/vortex_rdf/_native.abi3.so.sha256

# The generated N-Triples/N-Quads datasets and each library's built artifact.
# Hundreds of megabytes at the default scale, and reproducible from run.py.
/bench/.data/

# One virtualenv per library under comparison. Provisioned on demand by
# run.py, because their dependency sets conflict (pycottas pins an older
# pyoxigraph than the one we want to measure).
/bench/.venvs/
